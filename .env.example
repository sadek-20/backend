PORT=4000

# Local PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hafsa_travel

# Or Supabase pooler connection string from Dashboard → Database
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Use a long random string in production (32+ chars)
JWT_SECRET=change-me-to-a-long-random-string

# Default portal password for newly created customers
DEFAULT_CUSTOMER_PASSWORD=password123

# Optional one-time seed if DB has no PIN yet (then manage in Settings UI)
# STAFF_REVEAL_PIN=your-initial-pin

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# production | development
NODE_ENV=development
