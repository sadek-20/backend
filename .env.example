PORT=4000
NODE_ENV=production

# Supabase Database (Pooler URI from Dashboard → Database)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase API (Dashboard → Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Long random string (32+ chars) — required in production
JWT_SECRET=change-me-to-a-long-random-string

# Optional one-time seed if DB has no staff reveal PIN yet
# STAFF_REVEAL_PIN=your-initial-pin

# Vercel frontend URLs (comma-separated) — replace with your real domains
CORS_ORIGINS=https://your-admin.vercel.app,https://your-customer.vercel.app
